<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="my_custom_world">
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_walls">
      <static>true</static> <link name="wall_front">
        <pose>7.5 0 1 0 0 0</pose> <collision name="collision">
          <geometry><box><size>0.2 15.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 15.2 2</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_back">
        <pose>-7.5 0 1 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 15.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 15.2 2</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_left">
        <pose>0 7.5 1 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>15 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>15 0.2 2</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_right">
        <pose>0 -7.5 1 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>15 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>15 0.2 2</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cube_front">
      <pose>0 5 0.5 0 0 0</pose> 
      <static>false</static> <link name="link">
        <inertial>
          <mass>5.0</mass>
          <inertia ixx="0.83" ixy="0" ixz="0" iyy="0.83" iyz="0" izz="0.83"/>
        </inertial>
        
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient> <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="obstacle_cube_back">
      <pose>3 -5 0.5 0 0 0</pose> 
      <static>false</static> <link name="link">
        <inertial>
          <mass>5.0</mass>
          <inertia ixx="0.83" ixy="0" ixz="0" iyy="0.83" iyz="0" izz="0.83"/>
        </inertial>
        
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient> <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


  </world>
</sdf>
