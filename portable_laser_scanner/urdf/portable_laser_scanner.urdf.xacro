<?xml version="1.0"?>
<robot name="motor_test" xmlns:xacro="http://www.ros.org/wiki/xacro">
 
  <!-- Tripod -->
  <link name="world"/>

  <link name="tripod_hub">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
      <material name="black_matte">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="world_to_hub" type="fixed">
    <parent link="world"/>
    <child link="tripod_hub"/>
    <origin xyz="0 0 1.0" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="tripod_leg" params="suffix yaw_angle">
    <link name="leg_${suffix}">
      <visual>
        <origin xyz="0 0 -0.55" rpy="0 0 0"/> 
        <geometry>
          <cylinder radius="0.02" length="1.1"/>
        </geometry>
        <material name="tripod_gray">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.55" rpy="0 0 0"/> 
        <geometry>
          <cylinder radius="0.02" length="1.1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="hub_to_leg_${suffix}" type="fixed">
      <parent link="tripod_hub"/>
      <child link="leg_${suffix}"/>
      <origin xyz="0 0 0" rpy="0 0.4 ${yaw_angle}"/> 
    </joint>
  </xacro:macro>

  <xacro:tripod_leg suffix="1" yaw_angle="0.0"/>
  <xacro:tripod_leg suffix="2" yaw_angle="2.0944"/>
  <xacro:tripod_leg suffix="3" yaw_angle="4.1888"/>

  <joint name="tripod_to_base" type="fixed">
    <parent link="tripod_hub"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.125" rpy="0 0 0"/>
  </joint>
 
 
  <!-- Base box -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/> 
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5"/>
    </inertial>
    
    <visual>
      <geometry>
        <box size="0.2286 0.2286 0.2"/> <!-- 9x9 inches -->
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="wood">
        <color rgba="0.7 0.5 0.3 1.0"/>
      </material>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.2286 0.2286 0.2"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Rotating horizontal bar -->
  <link name="bar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.2286 0.05 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>

  <!-- Revolute joint connecting base to bar -->
  <joint name="base_to_bar" type="revolute">
    <parent link="base_link"/>
    <child link="bar_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="500" velocity="1.0"/>
  </joint>

  <!-- =============================== -->
  <!--      LEFT vertical bar          -->
  <!-- =============================== -->
  <link name="left_vertical_bar">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.05 0.127"/>  <!-- width, depth, height -->
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="metal_gray">
        <color rgba="0.8 0.8 0.85 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="bar_to_left_vertical" type="fixed">
    <parent link="bar_link"/>
    <child link="left_vertical_bar"/>
    <!-- Position at left end of the bar (x = -0.125), bar is 0.02 m thick in z -->
    <origin xyz="-0.1143 0 0.076" rpy="0 0 0"/>
  </joint>

  <!-- =============================== -->
  <!--      RIGHT vertical bar         -->
  <!-- =============================== -->
  <link name="right_vertical_bar">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.05 0.127"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="metal_gray">
        <color rgba="0.8 0.8 0.85 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="bar_to_right_vertical" type="fixed">
    <parent link="bar_link"/>
    <child link="right_vertical_bar"/>
    <!-- Position at right end of the bar (x = +0.125) -->
    <origin xyz="0.1143 0 0.076" rpy="0 0 0"/>
  </joint>
  
  <link name="sheet">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0.045 0.02" rpy="0 0 0"/>
      <geometry><box size="0.24 0.09 0.002"/></geometry> 
      <material name="metal_gray">
        <color rgba="0.8 0.8 0.85 1.0"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0 0.125 0.02" rpy="0 0 0"/>
      <geometry><box size="0.13 0.07 0.002"/></geometry>
      <material name="metal_gray"/>
    </visual>
    
    <!-- Right side triangle -->
    <visual>
      <origin xyz="-0.06 0.125 0.02" rpy="0 0 0"/>
      <geometry><box size="0.05 0.02 0.002"/></geometry>
      <material name="metal_gray"/>
    </visual>
    
    <visual>
      <origin xyz="-0.06 0.1 0.02" rpy="0 0 0"/>
      <geometry><box size="0.1 0.03 0.002"/></geometry>
      <material name="metal_gray"/>
    </visual>
    
    <!-- Left side triangle -->
    <visual>
      <origin xyz="0.06 0.125 0.02" rpy="0 0 0"/>
      <geometry><box size="0.05 0.02 0.002"/></geometry>
      <material name="metal_gray"/>
    </visual>
    
    <visual>
      <origin xyz="0.06 0.1 0.02" rpy="0 0 0"/>
      <geometry><box size="0.1 0.03 0.002"/></geometry>
      <material name="metal_gray"/>
    </visual>
  </link>
  
  <joint name="sheet_to_semi_octagon" type="fixed">
    <parent link="semi_octagon"/>
    <child link="sheet"/>
    <origin xyz="0 0 -0.045" rpy="0 0 0"/>
  </joint>
  
  <!-- Semi-Octagon -->
  
  <!-- Revolute joint: bar_link -> semi_octagon (allows the semi-octagon to pitch up/down) -->
  <joint name="bar_to_semi_octagon" type="revolute">
    <parent link="bar_link"/>
    <child link="semi_octagon"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <dynamics damping="1.0" friction="1.0"/>
    <!-- pitch axis (rotate up/down) -->
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="500" velocity="1.0"/>
  </joint>

  <!-- Semi-octagon link (made from 6 thin plates) -->
  <link name="semi_octagon">
    <!-- inertial (simple placeholder; tune mass/inertia for physics accuracy) -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>

    <!-- 1) Long base side (centered) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- size: length along X = distance between vertical bars (0.25), small thickness in Z -->
      <geometry><box size="0.2286 0.02 0.05"/></geometry>
      <material name="metal_gray"><color rgba="0.8 0.8 0.85 1.0"/></material>
    </visual>

    <!-- 2) Center top full-length side -->
    <visual>
      <origin xyz="0 0.158 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.02 0.05"/></geometry>
      <material name="metal_gray"/>
    </visual>

    <!-- 3) Left full-length side (slanted) -->
    <visual>
      <!-- moved left and slightly up, rotated ~30 degrees around Z to create an angled face -->
      <origin xyz="-0.09 0.124 0" rpy="0 0 0.785398"/> <!-- 45deg in radians -->
      <geometry><box size="0.0946658 0.02 0.05"/></geometry>
      <material name="metal_gray"/>
    </visual>

    <!-- 4) Right full-length side (slanted) -->
    <visual>
      <origin xyz="0.09 0.124 0" rpy="0 0 -0.785398"/>
      <geometry><box size="0.0946658 0.02 0.05"/></geometry>
      <material name="metal_gray"/>
    </visual>

    <!-- 5) Left half-length side (near left end) -->
    <visual>
      <!-- short plate near left end, angled more (45deg) -->
      <origin xyz="-0.125 0.045 0" rpy="0 0 1.57079633"/> <!-- 90deg -->
      <geometry><box size="0.1 0.02 0.05"/></geometry>
      <material name="metal_gray"/>
    </visual>

    <!-- 6) Right half-length side (near right end) -->
    <visual>
      <origin xyz="0.125 0.045 0" rpy="0 0 -1.57079633"/>
      <geometry><box size="0.1 0.02 0.05"/></geometry>
      <material name="metal_gray"/>
    </visual>

    <!-- (optional) simple collision: one box covering the whole semi-octagon footprint -->
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.28 0.04 0.10"/></geometry>
    </collision>
  </link>
  
  <!-- LiDAR -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="semi_octagon_to_lidar" type="fixed">
    <parent link="semi_octagon"/>
    <child link="lidar_link"/>
    <origin xyz="0 0.08 0.03" rpy="0 0 1.5708"/> <!-- 1.5708 = 90 Deg -->
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_ray"> 
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic> 
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-2.35619</min_angle>
            <max_angle>2.35619</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>50.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>
  
  <!-- Motors -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>bar_to_semi_octagon</joint_name>
      <topic>/model/motor_test_robot/joint/bar_to_semi_octagon/cmd_pos</topic>
      <p_gain>100.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>1.0</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>100</cmd_max>
      <cmd_min>-100</cmd_min>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>base_to_bar</joint_name>
      <topic>/model/motor_test_robot/joint/base_to_bar/cmd_pos</topic>
      <p_gain>100.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>5.0</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>100</cmd_max>
      <cmd_min>-100</cmd_min>
    </plugin>
  </gazebo>

</robot>

